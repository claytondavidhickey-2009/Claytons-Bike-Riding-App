/* trainer commands */
let lastSent=null,sending=false;
async function sendTrainer(cmd){ // cmd: {kind:'grade',g} | {kind:'erg',w}
  if((!TR.cp&&TR.proto!=='cps')||sending)return;const key=cmd.kind+':'+(cmd.kind==='grade'?cmd.g.toFixed(1):cmd.w);if(key===lastSent)return;sending=true;
