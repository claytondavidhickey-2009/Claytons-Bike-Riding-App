async function connectSP(){
  if(SP.dev&&SP.dev.gatt.connected){SP.dev.gatt.disconnect();return;}
  let dev;try{dev=await navigator.bluetooth.requestDevice({filters:[{services:[CSC]}],optionalServices:[CSC,FTMS,FEC.svc,KSC.svc]});}catch(e){if(e.name!=='NotFoundError')toast('Bluetooth: '+e.message,5000);return;}
  try{const g=await dev.gatt.connect();const ids=(await g.getPrimaryServices()).map(x=>x.uuid);
    if(ids.includes(BluetoothUUID.getService(FTMS))||ids.includes(FEC.svc)||ids.includes(KSC.svc)){g.disconnect();
      toast((dev.name||'That device')+' is a smart trainer, not a speed sensor. Connect it with the Trainer button instead.',8000);return;}}catch(e){}
  setSensor('Sp','busy','Connecting…');SP.dev=dev;dev.addEventListener('gattserverdisconnected',()=>{SP.kph=null;setSensor('Sp','','Disconnected');});
  try{const c=await (await (await dev.gatt.connect()).getPrimaryService(CSC)).getCharacteristic(0x2a5b);
    c.addEventListener('characteristicvaluechanged',e=>{const v=e.target.value,f=v.getUint8(0);let i=1;
      if(f&1){const rev=v.getUint32(i,true),tm=v.getUint16(i+4,true);i+=6;
        if(SP.lastRev!=null){const dr=rev-SP.lastRev,dt=((tm-SP.lastTime+65536)%65536)/1024;
          if(dt>0){SP.kph=dr*S.wheelMm/1e6/(dt/3600);SP.t=now();}else if(now()-SP.t>3000)SP.kph=0;}
        SP.lastRev=rev;SP.lastTime=tm;}
      if(f&2){const cr=v.getUint16(i,true),ct=v.getUint16(i+2,true);if(SP.lastC!=null){const dc=(cr-SP.lastC+65536)%65536,dt=((ct-SP.lastCT+65536)%65536)/1024;if(dt>0){SP.cad=dc/dt*60;SP.tc=now();}}SP.lastC=cr;SP.lastCT=ct;}
      if(SP.kph!=null)$('vSp').textContent=(dev.name||'Speed')+' · '+spd(SP.kph/3.6)+' '+spdU();});
    await c.startNotifications();setSensor('Sp','on',dev.name||'Speed sensor');}catch(e){setSensor('Sp','','Couldn\'t connect');toast('Speed sensor: '+e.message,6000);}
}
