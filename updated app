  {id:'pyr',name:'Pyramid',desc:'Efforts climb from 1 to 4 minutes and back down. 50 minutes.',steps:[W(600,'ftp',45,70),W(60,'ftp',110),W(60,'ftp',55),W(120,'ftp',105),W(120,'ftp',55),W(180,'ftp',100),W(180,'ftp',55),W(240,'ftp',95),W(240,'ftp',55),W(180,'ftp',100),W(180,'ftp',55),W(120,'ftp',105),W(120,'ftp',55),W(60,'ftp',110),W(300,'ftp',50,40)]},
  {id:'ramp',name:'FTP Ramp Test',desc:'Power rises 20 W every minute until you can\'t hold it. Your FTP is about 75% of your best 1-minute power. End the ride when you crack.',steps:[W(300,'watts',100),...Array.from({length:25},(_,i)=>W(60,'watts',120+i*20))]},
];
function allW(){return BUILTIN_W.concat(customW);}
function wDur(w){return w.steps.reduce((a,s)=>a+s.dur,0);}
function stepWatts(s,f){if(s.type==='ftp'){const p=s.to!=null?s.v+(s.to-s.v)*f:s.v;return Math.round(S.ftp*p/100);}if(s.type==='watts')return s.v;return null;}
function stepLabel(s){if(s.type==='ftp')return (s.to!=null?s.v+'→'+s.to:s.v)+'% FTP';if(s.type==='watts')return s.v+' W';if(s.type==='grade')return s.v+'% grade';return 'Ride the course';}
function stepIntensity(s,f=.5){if(s.type==='ftp'||s.type==='watts')return (stepWatts(s,f)||0)/S.ftp;if(s.type==='grade')return .55+s.v*.07;return .6;}
function zoneColor(x){const v=getComputedStyle(document.documentElement);const z=x<.56?1:x<.76?2:x<.91?3:x<1.06?4:x<1.21?5:6;return v.getPropertyValue('--z'+z).trim();}

/* ---------- canvas helpers ---------- */
function fitCanvas(cv){const r=cv.getBoundingClientRect(),dpr=window.devicePixelRatio||1;const w=Math.max(1,Math.round(r.width*dpr)),h=Math.max(1,Math.round(r.height*dpr));if(cv.width!==w||cv.height!==h){cv.width=w;cv.height=h;}const x=cv.getContext('2d');x.setTransform(dpr,0,0,dpr,0,0);return{x,w:r.width,h:r.height};}
function css(n){return getComputedStyle(document.documentElement).getPropertyValue(n).trim();}
function drawProfile(cv,c,pos,opts={}){
  const {x,w,h}=fitCanvas(cv);x.clearRect(0,0,w,h);if(!c)return;
  const pad=opts.labels?{l:64,r:8,t:8,b:18}:{l:2,r:2,t:4,b:2};const iw=w-pad.l-pad.r,ih=h-pad.t-pad.b;
  const lo=c.lo-(c.hi-c.lo)*.08-1,hi=c.hi+(c.hi-c.lo)*.05+1;const X=s=>pad.l+s/c.length*iw,Y=e=>pad.t+ih-(e-lo)/(hi-lo)*ih;
  // fill by grade colour
  const n=Math.max(8,Math.min(Math.floor(iw/4),Math.floor(c.length/150)));
  for(let i=0;i<n;i++){const s0=c.length*i/n,s1=c.length*(i+1)/n;const g=Math.abs((eleAt(c,s1)-eleAt(c,s0))/(s1-s0)*100);
    x.fillStyle=g<2?'#2d4a5c':g<4?'#3f7a5a':g<6?'#a08a2a':g<8?'#b8642a':'#b83a3a';
    x.beginPath();x.moveTo(X(s0),Y(lo));x.lineTo(X(s0),Y(eleAt(c,s0)));x.lineTo(X(s1),Y(eleAt(c,s1)));x.lineTo(X(s1),Y(lo));x.closePath();x.fill();}
  x.strokeStyle=css('--fg');x.lineWidth=1.5;x.beginPath();for(let i=0;i<=n;i++){const s=c.length*i/n;i?x.lineTo(X(s),Y(eleAt(c,s))):x.moveTo(X(s),Y(eleAt(c,s)));}x.stroke();
  if(opts.labels){x.fillStyle=css('--muted');x.font='11px JetBrains Mono, monospace';x.textAlign='right';
    [c.lo,c.hi].forEach(e=>x.fillText(alt(e).toLocaleString()+' '+altU(),pad.l-6,Y(e)+4));x.textAlign='left';x.fillText('0',pad.l,h-4);x.textAlign='right';x.fillText(dist(c.length,1)+' '+distU(),w-pad.r,h-4);}
  if(pos!=null){const px=X(pos),py=Y(eleAt(c,pos));x.strokeStyle=css('--accent');x.lineWidth=1;x.setLineDash([3,3]);x.beginPath();x.moveTo(px,pad.t);x.lineTo(px,pad.t+ih);x.stroke();x.setLineDash([]);
    x.fillStyle=css('--accent');x.beginPath();x.arc(px,py,6,0,7);x.fill();x.strokeStyle='#fff';x.lineWidth=2;x.stroke();}
}
function drawWorkout(cv,w,tNow){
  const {x,w:W2,h}=fitCanvas(cv);x.clearRect(0,0,W2,h);if(!w)return;const T=wDur(w);let t=0;
  const maxI=Math.max(1.3,...w.steps.map(s=>Math.max(stepIntensity(s,0),stepIntensity(s,1))));
  x.strokeStyle=css('--line');x.setLineDash([2,4]);const ly=h-h*(1/maxI);x.beginPath();x.moveTo(0,ly);x.lineTo(W2,ly);x.stroke();x.setLineDash([]);
  for(const s of w.steps){const x0=t/T*W2,x1=(t+s.dur)/T*W2;const a=stepIntensity(s,0),b=stepIntensity(s,1);
    x.fillStyle=zoneColor((a+b)/2);x.globalAlpha=tNow!=null&&t+s.dur<tNow?.45:.95;
    x.beginPath();x.moveTo(x0,h);x.lineTo(x0,h-h*a/maxI*.98);x.lineTo(Math.max(x0+.5,x1-.5),h-h*b/maxI*.98);x.lineTo(Math.max(x0+.5,x1-.5),h);x.fill();t+=s.dur;}
  x.globalAlpha=1;if(tNow!=null){const px=Math.min(1,tNow/T)*W2;x.fillStyle=css('--fg');x.fillRect(px-1,0,2,h);}
}

