function setSensor(k,state,text){$('d'+k).className='dot '+(state||'');$('v'+k).textContent=text;$('c'+k).textContent=state==='on'?'Disconnect':'Connect';}

async function connectTrainer(){
  if(TR.dev&&TR.dev.gatt.connected){TR.dev.gatt.disconnect();return;}
  let dev;try{dev=await navigator.bluetooth.requestDevice({filters:[{services:[KSC.svc]},{services:[FTMS]},{services:[FEC.svc]},{services:[CPS]},...TRAINER_NAMES.map(n=>({namePrefix:n}))],
    optionalServices:[KSC.svc,FTMS,FEC.svc,CPS,CSC,DIS]});}
  catch(e){if(e.name!=='NotFoundError')toast('Bluetooth: '+e.message,5000);return;}
  setSensor('Tr','busy','Connecting…');TR.dev=dev;TR.power=null;TR.cad=null;TR.kph=null;
  dev.addEventListener('gattserverdisconnected',()=>{TR.proto=null;TR.cp=null;setSensor('Tr','','Disconnected');if(R)toast('Trainer disconnected. Reconnect it from Home after the ride, or keep riding on backup speed.',6000);});
  try{const srv=await dev.gatt.connect();let svcs=[];try{svcs=(await srv.getPrimaryServices()).map(s=>s.uuid);}catch(e){}
    const has=u=>svcs.includes(typeof u==='number'?BluetoothUUID.getService(u):u);
    if(has(KSC.svc)){const s=await srv.getPrimaryService(KSC.svc);const p=await s.getCharacteristic(KSC.power);
      p.addEventListener('characteristicvaluechanged',e=>{const d=scDecode(e.target.value);if(d.length<14)return;TR.power=u16(d,3);TR.cad=d[12];
        if(d.length>=18)TR.kph=(((d[13]<<24)>>>0)+(d[14]<<16)+(d[15]<<8)+d[16])/1000;else{const t=u16(d,5);TR.kph=(t===0||t===65535)?0:6107.2561186/t;}TR.t=now();});
      await p.startNotifications();TR.cp=await s.getCharacteristic(KSC.control);TR.proto='sc';
      try{const c=await s.getCharacteristic(KSC.config);c.addEventListener('characteristicvaluechanged',e=>onCfg(e.target.value));await c.startNotifications();}catch(e){}
    }else if(has(FTMS)){const s=await srv.getPrimaryService(FTMS);const d=await s.getCharacteristic(0x2ad2);
      d.addEventListener('characteristicvaluechanged',e=>{const v=e.target.value;const f=v.getUint16(0,true);let i=2;
        if(!(f&1)){TR.kph=v.getUint16(i,true)/100;i+=2;}if(f&2)i+=2;if(f&4){TR.cad=v.getUint16(i,true)/2;i+=2;}if(f&8)i+=2;if(f&16)i+=3;if(f&32)i+=2;if(f&64)TR.power=v.getInt16(i,true);TR.t=now();});
      await d.startNotifications();TR.cp=await s.getCharacteristic(0x2ad9);try{await TR.cp.startNotifications();}catch(e){}
      await TR.cp.writeValueWithResponse(new Uint8Array([0x00]));          // request control
      try{await TR.cp.writeValueWithResponse(new Uint8Array([0x07]));}catch(e){} // start / resume
      TR.proto='ftms';
    }else if(has(FEC.svc)){const s=await srv.getPrimaryService(FEC.svc);const rx=await s.getCharacteristic(FEC.rx);
      rx.addEventListener('characteristicvaluechanged',e=>fecParse(e.target.value));await rx.startNotifications();
      TR.cp=await s.getCharacteristic(FEC.tx);TR.proto='fec';
      try{await fecWrite(fecUserConfig(S.riderKg,S.bikeKg));}catch(e){}
    }else if(has(CPS)){const c=await (await srv.getPrimaryService(CPS)).getCharacteristic(0x2a63);let lc=null,lt=null;
      c.addEventListener('characteristicvaluechanged',e=>{const v=e.target.value,f=v.getUint16(0,true);TR.power=v.getInt16(2,true);let i=4;
        if(f&1)i+=1;if(f&4)i+=2;if(f&16)i+=6;
        if(f&32){const cr=v.getUint16(i,true),ct=v.getUint16(i+2,true);if(lc!=null){const dt=((ct-lt+65536)%65536)/1024;if(dt>0)TR.cad=((cr-lc+65536)%65536)/dt*60;else if(now()-TR.t>2500)TR.cad=0;}lc=cr;lt=ct;}
        TR.t=now();});
      await c.startNotifications();TR.cp=null;TR.proto='cps';
      toast('Connected for power only. This trainer didn\'t offer resistance control, so hills won\'t change the resistance.',8000);
    }else throw new Error('This device doesn\'t look like a smart trainer.');
    const label={sc:'Kinetic',ftms:'FTMS',fec:'Tacx FE-C',cps:'power only'}[TR.proto];
    setSensor('Tr','on',(dev.name||'Trainer')+' · '+label);lastSent=null;
  }catch(e){setSensor('Tr','','Couldn\'t connect');toast('Trainer: '+e.message,6000);}
}
async function fecWrite(bytes){const c=TR.cp;if(c.writeValueWithoutResponse&&c.properties&&!c.properties.write)return c.writeValueWithoutResponse(bytes);return c.writeValueWithResponse(bytes);}
const CAL={0:'Not calibrated',1:'Starting…',2:'Speed up past about 21 mph',3:'Stop pedaling and coast',4:'Coasting… keep still',5:'You pedaled. Speed up and try again',10:'Calibrated'};
