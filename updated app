<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Clayton's Bike Riding App</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/maplibre-gl@4.7.1/dist/maplibre-gl.css">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Saira+Condensed:wght@500;700;800&family=Saira:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">
<style>
/* Layout: dark cockpit. Home = garage dashboard; ride = full-screen instrument panels switched with arrow keys */
:root{
  --bg:#0d1216; --bg2:#141b21; --panel:#18212a; --line:#26323d; --fg:#e8eef2; --muted:#8798a6;
  --accent:#ffb627; --accent-ink:#1a1206; --cool:#4fc3f7; --good:#52d273; --warn:#ff8a3d; --bad:#ff5c5c;
  --z1:#8798a6; --z2:#4fc3f7; --z3:#52d273; --z4:#ffd23f; --z5:#ff8a3d; --z6:#ff5c5c;
  --num:"Saira Condensed","Arial Narrow",system-ui,sans-serif;
  --ui:"Saira",system-ui,-apple-system,sans-serif;
  --mono:"JetBrains Mono",ui-monospace,Menlo,monospace;
  color-scheme:dark;
}
*{box-sizing:border-box}
html,body{margin:0;height:100%}
body{background:var(--bg);color:var(--fg);font:16px/1.5 var(--ui);-webkit-font-smoothing:antialiased}
button,input,select{font:inherit;color:inherit}
button{cursor:pointer;border:1px solid var(--line);background:var(--panel);border-radius:8px;padding:10px 16px;font-weight:600}
button:hover{border-color:var(--muted)}
button.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
button.ghost{background:transparent}
button.danger{border-color:var(--bad);color:var(--bad);background:transparent}
button:disabled{opacity:.4;cursor:not-allowed}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
input,select{background:var(--bg);border:1px solid var(--line);border-radius:6px;padding:8px 10px;min-width:0}
[hidden]{display:none!important}
.lbl{font:500 .72rem var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.view{min-height:100%;padding:28px max(20px,env(safe-area-inset-right,0px)) 48px max(20px,env(safe-area-inset-left,0px))}
.wrap{max-width:1040px;margin:0 auto;display:grid;gap:24px}
.topbar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px}
.brand{font:800 1.5rem/1 var(--num);letter-spacing:.04em;text-transform:uppercase}
.brand span{color:var(--accent)}
h2{font:700 1.8rem/1.1 var(--num);letter-spacing:.02em;margin:0;text-transform:uppercase}
h3{font:700 1.15rem var(--ui);margin:0}
.muted{color:var(--muted)}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:20px}

/* home */
.odo{display:grid;gap:4px;padding:36px 28px;border-radius:14px;background:radial-gradient(120% 140% at 0% 0%,#1d2832 0%,var(--bg2) 60%);border:1px solid var(--line)}
.odo .big{font:800 clamp(4.5rem,13vw,9rem)/.9 var(--num);font-variant-numeric:tabular-nums;color:var(--accent);letter-spacing:-.01em}
.odo .big small{font-size:.32em;color:var(--muted);margin-left:8px;letter-spacing:.04em}
.odo .sub{display:flex;flex-wrap:wrap;gap:8px 28px;font:500 1rem var(--mono);color:var(--muted)}
.actions{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:12px}
.act{display:grid;gap:6px;text-align:left;padding:20px;border-radius:12px;min-height:118px;align-content:end}
.act b{font:800 1.7rem/1 var(--num);text-transform:uppercase;letter-spacing:.03em}
.act span{font-weight:400;color:var(--muted);font-size:.92rem}
.act.primary span{color:#3a2a08}
@media (max-width:760px){.actions{grid-template-columns:1fr 1fr}.actions .act.primary{grid-column:1/-1}}
.sensors{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
@media (max-width:760px){.sensors{grid-template-columns:1fr}}
.sensor{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px}
.sensor .st{display:flex;align-items:center;gap:10px;min-width:0}
.dot{width:10px;height:10px;border-radius:50%;background:var(--line);flex:none}
.dot.on{background:var(--good);box-shadow:0 0 10px var(--good)} .dot.busy{background:var(--warn)}
.sensor .name{font-weight:600} .sensor .val{font:500 .8rem var(--mono);color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

/* lists */
.list{display:grid;gap:10px}
.item{display:grid;grid-template-columns:1fr auto;gap:10px 16px;align-items:center;padding:16px 18px}
.item .meta{font:500 .8rem var(--mono);color:var(--muted)}
.item .btns{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}
.item canvas{grid-column:1/-1;width:100%;height:46px;display:block}
.tagrow{display:flex;gap:6px;flex-wrap:wrap}
.tag{font:500 .7rem var(--mono);text-transform:uppercase;letter-spacing:.08em;padding:2px 8px;border-radius:99px;border:1px solid var(--line);color:var(--muted)}
.tag.climb{border-color:var(--warn);color:var(--warn)}

/* forms */
.form{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px}
.field{display:grid;gap:6px}
.field label{font-size:.9rem;color:var(--muted)}
.steps{display:grid;gap:8px}
.steprow{display:grid;grid-template-columns:28px 1fr 1.2fr 1fr auto;gap:8px;align-items:center}
.steprow .n{font:500 .8rem var(--mono);color:var(--muted)}
@media (max-width:640px){.steprow{grid-template-columns:24px 1fr 1fr}.steprow .x{grid-column:2/-1}}

/* modal */
.modal{position:fixed;inset:0;background:rgba(5,8,10,.78);display:grid;place-items:center;padding:20px;z-index:2000}
.modal .box{background:var(--bg2);border:1px solid var(--line);border-radius:14px;width:min(720px,100%);max-height:88vh;overflow:auto;padding:22px;display:grid;gap:16px}

/* ride */
#ride{position:fixed;inset:0;display:grid;grid-template-rows:auto 1fr;background:var(--bg)}
.ridebar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px max(16px,env(safe-area-inset-right,0px)) 10px max(16px,env(safe-area-inset-left,0px));border-bottom:1px solid var(--line);background:var(--bg2)}
.ridebar .where{display:flex;gap:14px;align-items:baseline;min-width:0}
.ridebar .where b{font:700 1.15rem var(--num);text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tabsdots{display:flex;gap:8px}
.tabsdots button{padding:6px 12px;font:600 .8rem var(--mono);text-transform:uppercase;letter-spacing:.06em;background:transparent}
.tabsdots button[aria-current="true"]{background:var(--fg);color:var(--bg);border-color:var(--fg)}
.screen{min-height:0;display:grid;padding:16px max(16px,env(safe-area-inset-right,0px)) 16px max(16px,env(safe-area-inset-left,0px));gap:14px}
.tile{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px 18px;display:grid;align-content:space-between;min-width:0;overflow:hidden}
.tile .v{font:700 clamp(2.6rem,6.5vw,5.2rem)/1 var(--num);font-variant-numeric:tabular-nums;white-space:nowrap}
.tile .u{font:500 .38em var(--num);color:var(--muted);margin-left:6px;letter-spacing:.04em}
#scrData{grid-template-columns:repeat(4,1fr);grid-template-rows:1.6fr 1fr 1fr auto;--vs:1}
#scrData .tile:not(.dist):not(.strip) .v{font-size:calc(clamp(2.6rem,6.5vw,5.2rem)*var(--vs))}
#scrData .dist{grid-column:1/-1;align-content:center;justify-items:center;background:radial-gradient(90% 120% at 50% 0%,#1f2b35,var(--panel))}
#scrData .dist .v{font-size:calc(clamp(6rem,19vw,15rem)*var(--vb,1));color:var(--accent);letter-spacing:-.01em}
#scrData .wide{grid-column:span 2}
.dsgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.dsgrid .slot{display:grid;gap:4px;background:var(--bg2);border:1px solid var(--line);border-radius:8px;padding:10px}
.dsgrid .slot.big{grid-column:1/-1;border-color:var(--accent)}
.dsgrid .slot.wide{grid-column:span 2}
.dsgrid .slot .top{display:flex;justify-content:space-between;align-items:center;gap:6px}
.dsgrid .slot .rm{padding:0 8px;line-height:1.6;font-size:.8rem}
.dsgrid .slot label{font:500 .7rem var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
@media (max-width:640px){.dsgrid{grid-template-columns:1fr 1fr}.dsgrid .slot.wide{grid-column:span 1}}
#scrData .strip{grid-column:1/-1;padding:10px 14px}
#scrData .strip canvas{width:100%;height:70px;display:block}
@media (max-width:760px){#scrData{grid-template-columns:1fr 1fr;grid-template-rows:auto!important}#scrData .wide{grid-column:span 1}}
.gradechip{display:inline-block;font:700 1rem var(--mono);padding:2px 10px;border-radius:6px;background:var(--line)}

#scrWorkout{grid-template-columns:1.3fr 1fr;grid-template-rows:auto 1fr auto}
#scrWorkout .now{grid-row:span 2;align-content:center;gap:10px}
#scrWorkout .target{font:800 clamp(5rem,13vw,11rem)/.95 var(--num);font-variant-numeric:tabular-nums}
#scrWorkout .left{font:700 clamp(3rem,7vw,5.5rem)/1 var(--num);font-variant-numeric:tabular-nums}
#scrWorkout .chart{grid-column:1/-1;padding:12px 14px}
#scrWorkout .chart canvas{width:100%;height:120px;display:block}
.bar{height:10px;border-radius:99px;background:var(--line);overflow:hidden}
.bar i{display:block;height:100%;background:var(--accent);width:0}
@media (max-width:760px){#scrWorkout{grid-template-columns:1fr}#scrWorkout .now{grid-row:auto}}

#scrMap{grid-template-rows:1fr auto;grid-template-columns:1fr 260px}
#map{border-radius:12px;border:1px solid var(--line);min-height:240px;background:#0b0f12}
#scrMap .side{display:grid;gap:12px;align-content:start}
#scrMap .side .tile .v{font-size:clamp(2.2rem,4vw,3.4rem)}
#scrMap .prof{grid-column:1/-1;padding:10px 14px}
#scrMap .prof canvas{width:100%;height:150px;display:block}
@media (max-width:760px){#scrMap{grid-template-columns:1fr}#scrMap .side{grid-template-columns:1fr 1fr}}
#scr3d{padding:0;position:relative;display:block}
#scr3d[hidden]{display:none!important}
#map3d{position:absolute;inset:0;background:linear-gradient(#5f8fb8 0%,#a9c6dc 55%,#d8e3ea 100%)}
.hud{position:absolute;left:16px;right:16px;top:14px;display:flex;flex-wrap:wrap;gap:10px;pointer-events:none;z-index:5}
.hud .tile{background:rgba(13,18,22,.78);backdrop-filter:blur(6px);border-color:rgba(255,255,255,.08);padding:10px 16px;min-width:120px}
.hud .tile .v{font-size:clamp(2rem,3.6vw,3.2rem)}
.hud .tile.big .v{color:var(--accent);font-size:clamp(2.6rem,4.8vw,4.2rem)}
.hud3dprof{position:absolute;left:16px;right:16px;bottom:14px;height:86px;background:rgba(13,18,22,.78);border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:8px 12px;z-index:5;pointer-events:none}
.hud3dprof canvas{width:100%;height:100%;display:block}
.cam3d{position:absolute;right:16px;bottom:114px;display:grid;gap:6px;z-index:6}
.cam3d button{background:rgba(13,18,22,.85);padding:6px 12px;font:600 .8rem var(--mono)}
.lay3d{position:absolute;top:14px;right:16px;z-index:7;display:grid;justify-items:end;gap:6px}
.lay3d>button{width:44px;height:44px;padding:0;display:grid;place-items:center;background:rgba(13,18,22,.85);border-color:rgba(255,255,255,.15)}
.lay3d .menu{background:rgba(13,18,22,.92);backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,.12);border-radius:10px;padding:12px 14px;display:grid;gap:4px;min-width:170px}
.lay3d .menu .lbl{margin:4px 0 2px}
.lay3d label{display:flex;gap:8px;align-items:center;cursor:pointer;padding:3px 0;font-size:.95rem}
.lay3d input{accent-color:var(--accent)}
.lay3d hr{border:0;border-top:1px solid var(--line);margin:6px 0}
#scr3d .hud{right:76px}
.msg3d{position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:24px;color:var(--muted);z-index:4}
.maplibregl-ctrl-attrib{font-size:10px}
.maplibregl-marker{position:absolute;top:0;left:0;will-change:transform}
#map3d canvas{outline:none}
.leaflet-container{font:12px var(--ui)}
.riderdot{width:18px;height:18px;border-radius:50%;background:var(--accent);border:3px solid #fff;box-shadow:0 0 0 6px rgba(255,182,39,.3)}

.toast{position:fixed;left:50%;bottom:max(24px,env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--fg);color:var(--bg);padding:12px 20px;border-radius:10px;font-weight:600;z-index:3000;box-shadow:0 8px 30px rgba(0,0,0,.5);max-width:calc(100% - 32px)}
.kbd{font:500 .75rem var(--mono);border:1px solid var(--line);border-radius:4px;padding:1px 6px;color:var(--muted)}
.summ{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
@media (max-width:640px){.summ{grid-template-columns:1fr 1fr}}
.summ .tile .v{font-size:2.6rem}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>
</head>
<body>

<!-- HOME -->
<section class="view" id="home">
  <div class="wrap">
    <div class="topbar">
      <div class="brand">Clayton's <span>Bike Riding</span> App</div>
      <button class="ghost" data-go="settings">Settings</button>
    </div>
    <div class="odo">
      <div class="lbl">Total distance ridden</div>
      <div class="big"><span id="odoVal">0.0</span><small id="odoUnit">mi</small></div>
      <div class="sub"><span id="odoRides">0 rides</span><span id="odoTime">0 h 0 min in the saddle</span><span id="odoClimb">0 ft climbed</span></div>
    </div>
    <div class="actions">
      <button class="act primary" id="btnFree"><b>Free Ride</b><span>Pick a course and ride it at your own pace</span></button>
      <button class="act" data-go="workouts"><b>Workouts</b><span>Library and builder</span></button>
      <button class="act" data-go="courses"><b>Courses</b><span>Climbs and elevation profiles</span></button>
      <button class="act" data-go="settings"><b>Settings</b><span>Your stats</span></button>
    </div>
    <div>
      <div class="lbl" style="margin-bottom:10px">Sensors</div>
      <div class="sensors">
        <div class="panel sensor"><div class="st"><span class="dot" id="dTr"></span><div style="min-width:0"><div class="name">Trainer</div><div class="val" id="vTr">Not connected</div></div></div><button id="cTr">Connect</button></div>
        <div class="panel sensor"><div class="st"><span class="dot" id="dHr"></span><div style="min-width:0"><div class="name">Heart rate</div><div class="val" id="vHr">Not connected</div></div></div><button id="cHr">Connect</button></div>
        <div class="panel sensor"><div class="st"><span class="dot" id="dSp"></span><div style="min-width:0"><div class="name">Speed sensor</div><div class="val" id="vSp">Not connected</div></div></div><button id="cSp">Connect</button></div>
      </div>
      <p class="muted" id="btWarn" hidden style="margin:12px 0 0">Bluetooth isn't available here. Open this file directly in Google Chrome (drag it onto a Chrome window).</p>
    </div>
    <div class="panel" id="recoverBox" hidden>
      <h3>Unfinished ride found</h3>
      <p class="muted" style="margin:6px 0 12px">The app closed before you ended your last ride. You can still save it.</p>
      <div style="display:flex;gap:10px;flex-wrap:wrap"><button class="primary" id="btnRecover">Finish and save it</button><button class="ghost" id="btnDiscard">Discard</button></div>
    </div>
  </div>
</section>

<!-- WORKOUTS -->
<section class="view" id="workouts" hidden>
  <div class="wrap">
    <div class="topbar"><h2>Workouts</h2><div style="display:flex;gap:8px"><button class="primary" id="btnNewW">Build a workout</button><button class="ghost" data-go="home">Home</button></div></div>
    <p class="muted" style="margin:0">Targets scale to your FTP (<span id="ftpNote">200</span> W). Change it in Settings.</p>
    <div class="list" id="wList"></div>
  </div>
</section>

<!-- BUILDER -->
<section class="view" id="builder" hidden>
  <div class="wrap">
    <div class="topbar"><h2 id="bTitle">Build a workout</h2><button class="ghost" data-go="workouts">Cancel</button></div>
    <div class="panel" style="display:grid;gap:16px">
      <div class="form">
        <div class="field"><label for="bName">Name</label><input id="bName" placeholder="Tuesday hill repeats"></div>
        <div class="field" style="grid-column:span 2"><label for="bDesc">Description</label><input id="bDesc" placeholder="What this workout is for"></div>
      </div>
      <canvas id="bChart" style="width:100%;height:90px;display:block"></canvas>
      <div class="lbl">Steps · <span id="bTotal">0 min</span></div>
      <div class="steps" id="bSteps"></div>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <button id="bAdd">Add step</button>
      </div>
      <div class="panel" style="background:var(--bg2);display:grid;gap:10px">
        <h3>Add an interval set</h3>
        <div class="form" style="grid-template-columns:repeat(auto-fill,minmax(130px,1fr))">
          <div class="field"><label for="iReps">Repeats</label><input id="iReps" type="number" value="5" min="1" max="30"></div>
          <div class="field"><label for="iOnMin">Work (min)</label><input id="iOnMin" type="number" value="3" min="0.25" step="0.25"></div>
          <div class="field"><label for="iOnType">Work type</label><select id="iOnType"><option value="ftp">% FTP</option><option value="watts">Watts</option><option value="grade">Grade %</option></select></div>
          <div class="field"><label for="iOnV">Work target</label><input id="iOnV" type="number" value="110"></div>
          <div class="field"><label for="iOffMin">Rest (min)</label><input id="iOffMin" type="number" value="3" min="0.25" step="0.25"></div>
          <div class="field"><label for="iOffV">Rest % FTP</label><input id="iOffV" type="number" value="55"></div>
        </div>
        <div><button id="iAdd">Add set</button></div>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap"><button class="primary" id="bSave">Save workout</button><button class="danger" id="bDelete" hidden>Delete workout</button></div>
    </div>
  </div>
</section>

<!-- COURSES -->
<section class="view" id="courses" hidden>
  <div class="wrap">
    <div class="topbar"><h2>Courses</h2><div style="display:flex;gap:8px"><button class="primary" id="btnImport">Import GPX route</button><button class="ghost" data-go="home">Home</button></div></div>
    <input type="file" id="gpxFile" accept=".gpx,application/gpx+xml" hidden>
    <p class="muted" style="margin:0">Export a route from Strava or RideWithGPS as a .gpx file, then import it here to ride real roads.</p>
    <div class="list" id="cList"></div>
    <p class="muted" style="font-size:.8rem;margin:0">Built-in routes © OpenStreetMap contributors (ODbL), via the open-source Serpentine project.</p>
  </div>
</section>

<!-- SETTINGS -->
<section class="view" id="settings" hidden>
  <div class="wrap">
    <div class="topbar"><h2>Settings</h2><button class="ghost" data-go="home">Home</button></div>
    <div class="panel" style="display:grid;gap:18px">
      <h3>You</h3>
      <div class="form">
        <div class="field"><label for="sName">Name</label><input id="sName"></div>
        <div class="field"><label for="sAge">Age</label><input id="sAge" type="number" min="5" max="110"></div>
        <div class="field"><label for="sUnits">Units</label><select id="sUnits"><option value="imperial">Miles, feet, pounds</option><option value="metric">Kilometers, meters, kilograms</option></select></div>
        <div class="field"><label for="sRider">Your weight (<span class="wu">lb</span>)</label><input id="sRider" type="number" step="0.1"></div>
        <div class="field"><label for="sBike">Bike weight (<span class="wu">lb</span>)</label><input id="sBike" type="number" step="0.1"></div>
        <div class="field"><label for="sFtp">FTP (watts)</label><input id="sFtp" type="number" min="50" max="600"></div>
        <div class="field"><label for="sMaxHr">Max heart rate</label><input id="sMaxHr" type="number" min="100" max="230"></div>
        <div class="field"><label for="sRestHr">Resting heart rate</label><input id="sRestHr" type="number" min="30" max="110"></div>
      </div>
      <h3>Trainer</h3>
      <div class="form">
        <div class="field"><label for="sDiff">Hill difficulty (%)</label><input id="sDiff" type="number" min="0" max="150" step="5"><span class="muted" style="font-size:.85rem">100% = real grades. Lower it if steep climbs make your tire slip.</span></div>
        <div class="field"><label for="sWheel">Wheel size for speed sensor (mm)</label><input id="sWheel" type="number" min="1000" max="2500"><span class="muted" style="font-size:.85rem">700×25c ≈ 2105, 700×28c ≈ 2136</span></div>
      </div>
      <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center"><button class="primary" id="sSave">Save settings</button><button id="sCal">Calibrate trainer</button><span class="muted" id="calMsg"></span></div>
    </div>
    <div class="panel" style="display:grid;gap:14px">
      <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:10px"><h3>Data screen</h3><button class="ghost" id="dsReset">Reset to default</button></div>
      <p class="muted" style="margin:0">Choose what each box on the ride's Data screen shows. Changes save right away.</p>
      <div class="dsgrid" id="dsGrid"></div>
      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap"><button id="dsAdd">Add a box</button><span class="muted" id="dsCount"></span></div>
