$('sCal').onclick=async()=>{if(!TR.proto){toast('Connect your trainer first (Home → Sensors).');return;}if(TR.proto!=='sc'){toast('Only the Kinetic needs calibrating here. Tacx, Wahoo and other direct-drive trainers calibrate themselves or in their own app.',7000);return;}
  try{await TR.cp.writeValueWithResponse(scEncode([0x03,0x01,0x00,0]));$('calMsg').textContent='Speed up past about 21 mph, then coast when told.';}catch(e){toast('Calibration failed: '+e.message);}};

