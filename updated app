  let a=1e9,b=-1e9,d=1e9,e=-1e9;c.pts.forEach(p=>{a=Math.min(a,p[1]*k);b=Math.max(b,p[1]*k);d=Math.min(d,p[0]);e=Math.max(e,p[0]);});
