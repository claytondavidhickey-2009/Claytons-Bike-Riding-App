/* ---------- courses ---------- */
function hav(a,b){const R=6371000,r=Math.PI/180,dp=(b[0]-a[0])*r,dl=(b[1]-a[1])*r;const x=Math.sin(dp/2)**2+Math.cos(a[0]*r)*Math.cos(b[0]*r)*Math.sin(dl/2)**2;return 2*R*Math.asin(Math.sqrt(x));}
function prepCourse(c){
  if(c._d)return c;const p=c.pts,d=[0];for(let i=1;i<p.length;i++)d.push(d[i-1]+hav(p[i-1],p[i]));
  c._d=d;c.length=d[d.length-1];let g=0,lo=1e9,hi=-1e9;for(let i=0;i<p.length;i++){if(i&&p[i][2]>p[i-1][2])g+=p[i][2]-p[i-1][2];lo=Math.min(lo,p[i][2]);hi=Math.max(hi,p[i][2]);}
  c.gain=g;c.lo=lo;c.hi=hi;c.avg=c.loop?0:(p[p.length-1][2]-p[0][2])/c.length*100;return c;}
function allCourses(){return BUILTIN_COURSES.concat(customC).map(prepCourse);}
function courseAt(c,s){ // s in meters along course -> {lat,lon,ele}
  const d=c._d,p=c.pts;s=Math.max(0,Math.min(c.length,s));let lo=0,hi=d.length-1;
  while(hi-lo>1){const m=(lo+hi)>>1;if(d[m]<=s)lo=m;else hi=m;}
  const f=d[hi]>d[lo]?(s-d[lo])/(d[hi]-d[lo]):0;
  return{lat:p[lo][0]+(p[hi][0]-p[lo][0])*f,lon:p[lo][1]+(p[hi][1]-p[lo][1])*f,ele:p[lo][2]+(p[hi][2]-p[lo][2])*f};}
function eleAt(c,s){if(c.loop){s=((s%c.length)+c.length)%c.length;}return courseAt(c,s).ele;}
function gradeAt(c,s){const w=100;let a=s-w,b=s+w;if(!c.loop){a=Math.max(0,a);b=Math.min(c.length,b);}if(b-a<1)return 0;return (eleAt(c,b)-eleAt(c,a))/(b-a)*100;}

function parseGPX(text,name){
  const doc=new DOMParser().parseFromString(text,'application/xml');
  let nodes=[...doc.getElementsByTagName('trkpt')];if(!nodes.length)nodes=[...doc.getElementsByTagName('rtept')];
  if(nodes.length<2)throw new Error('No track points found in that file.');
  const raw=nodes.map(n=>{const e=n.getElementsByTagName('ele')[0];return[+n.getAttribute('lat'),+n.getAttribute('lon'),e?+e.textContent:0];}).filter(p=>isFinite(p[0])&&isFinite(p[1]));
  const keep=[raw[0]];let acc=0;
  for(let i=1;i<raw.length;i++){acc+=hav(raw[i-1],raw[i]);if(acc>=25||i===raw.length-1){keep.push(raw[i]);acc=0;}}
  const sm=keep.map((p,i)=>{const w=keep.slice(Math.max(0,i-3),i+4);return[+p[0].toFixed(5),+p[1].toFixed(5),+(w.reduce((a,q)=>a+q[2],0)/w.length).toFixed(1)];});
  const loop=hav(sm[0],sm[sm.length-1])<150;
  const tn=doc.getElementsByTagName('name')[0];
  return{id:'c'+Date.now(),name:(tn&&tn.textContent.trim())||name.replace(/\.gpx$/i,''),region:'Imported',loop,pts:sm,custom:true,noEle:!nodes.some(n=>n.getElementsByTagName('ele').length)};
}

/* ---------- workouts ---------- */
const W=(dur,type,v,to)=>({dur,type,v,...(to!=null?{to}:{})});
const rep=(n,steps)=>Array.from({length:n},()=>steps.map(s=>Object.assign({},s))).flat();
const BUILTIN_W=[
