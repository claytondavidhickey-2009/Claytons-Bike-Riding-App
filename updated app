function scDecode(dv){const d=new Uint8Array(dv.buffer.slice(dv.byteOffset,dv.byteOffset+dv.byteLength));const n=d.length;let h=T8[0x42^d[n-1]];for(let i=0;i<n-1;i++){d[i]^=h;h=T8[h^d[i]];}return d;}
function scEncode(b){const d=Uint8Array.from(b);d[d.length-1]=Math.floor(Math.random()*256);const n=d.length;let h=T8[0x42^d[n-1]];for(let i=0;i<n-1;i++){const t=d[i];d[i]^=h;h=T8[h^t];}return d;}
const u16=(a,i)=>(a[i]<<8)|a[i+1];
const now=()=>performance.now();

const TR={dev:null,proto:null,cp:null,power:null,cad:null,kph:null,t:0,busy:false};
const HR={dev:null,bpm:null,t:0};
