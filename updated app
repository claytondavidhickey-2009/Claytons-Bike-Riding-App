// ANT+ FE-C over Bluetooth (Tacx): 8-byte data pages wrapped in an ANT message
function fecMsg(page){const m=[0xA4,0x09,0x4E,0x05,...page];m.push(m.reduce((a,b)=>a^b,0));return Uint8Array.from(m);}
function fecTargetPower(w){const q=Math.max(0,Math.min(4000,Math.round(w*4)));return fecMsg([0x31,0xFF,0xFF,0xFF,0xFF,0xFF,q&255,q>>8]);}
function fecGrade(g){const v=Math.round((Math.max(-200,Math.min(200,g))+200)*100);return fecMsg([0x33,0xFF,0xFF,0xFF,0xFF,v&255,v>>8,0x50]);}
function fecUserConfig(riderKg,bikeKg){const u=Math.round(riderKg*100),b=Math.round(bikeKg*20);// bike weight 0.05 kg units, 12 bits; wheel 700c = 70 (0.01 m) diameter not set
  return fecMsg([0x37,u&255,u>>8,0xFF,((b&0x0F)<<4)|0x0F,b>>4,0xFF,0x00]);}
