const REDIRECT='http://localhost/exchange_token';
function renderStrava(){$('stvId').value=STV.id;$('stvSecret').value=STV.secret;$('stvAuto').checked=!!STV.auto;
  const on=!!STV.refresh;$('stvStatus').textContent=on?'Connected'+(STV.athlete?' as '+STV.athlete:''):'Not connected';$('stvStatus').style.color=on?css('--good'):'';$('stvStatus').style.borderColor=on?css('--good'):'';
  $('stvConnect').textContent=on?'Reconnect':'Connect to Strava';$('stvDisconnect').hidden=!on;}
$('stvAuto').onchange=()=>{STV.auto=$('stvAuto').checked;saveStv();};
$('stvConnect').onclick=()=>{STV.id=$('stvId').value.trim();STV.secret=$('stvSecret').value.trim();
  if(!/^\d+$/.test(STV.id)){toast('Client ID should be just numbers. Copy it from strava.com/settings/api.',5000);return;}
  if(STV.secret.length<20){toast('That Client Secret looks too short. Click "show" on the Strava page and copy the whole thing.',5000);return;}
  saveStv();const u='https://www.strava.com/oauth/authorize?client_id='+encodeURIComponent(STV.id)+'&response_type=code&redirect_uri='+encodeURIComponent(REDIRECT)+'&approval_prompt=force&scope=read,activity:write';
  const a=document.createElement('a');a.href=u;a.target='_blank';a.rel='noopener';document.body.appendChild(a);a.click();a.remove();$('stvStep2').hidden=false;$('stvUrl').focus();};
$('stvFinish').onclick=async()=>{const raw=$('stvUrl').value.trim();let code=null,scope='';
  try{const q=new URL(raw).searchParams;code=q.get('code');scope=q.get('scope')||'';if(q.get('error'))throw new Error('You clicked Cancel on Strava. Try again and click Authorize.');}catch(e){if(e.message.startsWith('You'))return toast(e.message,6000);}
  if(!code&&/^[0-9a-f]{20,}$/i.test(raw))code=raw;
  if(!code)return toast('Couldn\'t find the code in that address. Copy the whole address bar from the Strava tab.',6000);
  if(scope&&!scope.includes('activity:write'))return toast('Strava didn\'t give upload permission. Reconnect and leave "Upload your activities" checked.',7000);
  $('stvFinish').disabled=true;
  try{const r=await stvToken({grant_type:'authorization_code',code});STV.athlete=r.athlete?[r.athlete.firstname,r.athlete.lastname].filter(Boolean).join(' '):'';
    saveStv();$('stvStep2').hidden=true;$('stvUrl').value='';renderStrava();toast('Connected to Strava'+(STV.athlete?' as '+STV.athlete:'')+'!');}
  catch(e){toast(e.message,8000);}finally{$('stvFinish').disabled=false;}};
$('stvDisconnect').onclick=()=>{STV.access=null;STV.refresh=null;STV.expires=0;STV.athlete='';saveStv();renderStrava();toast('Disconnected from Strava');};
async function stvToken(params){
  const body=new URLSearchParams(Object.assign({client_id:STV.id,client_secret:STV.secret},params));let res;
  try{res=await fetch('https://www.strava.com/oauth/token',{method:'POST',body});}catch(e){throw new Error('Couldn\'t reach Strava. Check your internet connection.');}
  const j=await res.json().catch(()=>({}));
  if(!res.ok){const bad=JSON.stringify(j.errors||j.message||'');
    if(/client_id|client_secret|invalid/i.test(bad)&&params.grant_type==='authorization_code')throw new Error('Strava rejected the keys or the code. Double-check the Client ID and Secret, then connect again (each code only works once).');
    if(params.grant_type==='refresh_token'){STV.refresh=null;STV.access=null;saveStv();throw new Error('Strava sign-in expired. Reconnect in Settings → Strava.');}
    throw new Error('Strava said: '+(j.message||res.status));}
  STV.access=j.access_token;STV.refresh=j.refresh_token||STV.refresh;STV.expires=j.expires_at||0;saveStv();return j;}
async function stvAccess(){if(!STV.refresh)throw new Error('Connect Strava first in Settings → Strava.');
  if(!STV.access||Date.now()/1000>STV.expires-300)await stvToken({grant_type:'refresh_token',refresh_token:STV.refresh});return STV.access;}
async function uploadStrava(ride){
  const btn=$('btnStv'),msg=$('stvMsg');if(ride.uploaded){window.open('https://www.strava.com/activities/'+ride.uploaded,'_blank');return;}
  if(!STV.refresh){toast('First connect Strava in Settings → Strava.',5000);return;}
  btn.disabled=true;msg.textContent='Uploading…';
  try{const tok=await stvAccess();const fd=new FormData();
    fd.append('file',new Blob([buildFIT(ride)],{type:'application/octet-stream'}),'ride.fit');fd.append('data_type','fit');fd.append('trainer','1');
    fd.append('name',ride.name+(ride.workout?' · '+ride.workout:''));fd.append('description','Ridden on Clayton\'s Bike Riding App');fd.append('external_id','cbra-'+ride.start);
    const res=await fetch('https://www.strava.com/api/v3/uploads',{method:'POST',headers:{Authorization:'Bearer '+tok},body:fd});
    let j=await res.json().catch(()=>({}));if(!res.ok)throw new Error(j.message||('Upload failed ('+res.status+')'));
    msg.textContent='Strava is processing it…';
    for(let i=0;i<30&&!j.activity_id&&!j.error;i++){await new Promise(r=>setTimeout(r,2000));
      const r2=await fetch('https://www.strava.com/api/v3/uploads/'+j.id,{headers:{Authorization:'Bearer '+tok}});j=await r2.json().catch(()=>j);}
    if(j.error){if(/duplicate/i.test(j.error))throw new Error('This ride is already on Strava.');throw new Error(j.error);}
    if(!j.activity_id){msg.textContent='Uploaded. Strava is still processing it; check your feed in a minute.';btn.disabled=false;return;}
    ride.uploaded=j.activity_id;msg.innerHTML='';msg.textContent='On Strava ✓';btn.textContent='View on Strava';btn.disabled=false;toast('Ride uploaded to Strava!');}
  catch(e){const m=e instanceof TypeError?'Couldn\'t reach Strava. Use "Download ride file" below for now.':e.message;msg.textContent=m;btn.disabled=false;}}
$('btnStv').onclick=()=>LAST&&uploadStrava(LAST);
$('btnRecover').onclick=()=>{const l=store.get('live',null);if(!l){renderHome();return;}finishRide({course:{name:l.course.name},workout:l.workout,start:l.start,elapsed:l.elapsed,dist:l.dist,ascent:l.ascent,samples:l.samples||[],
  maxP:l.maxP,sumP:l.sumP,nP:l.nP,sumHr:l.sumHr,nHr:l.nHr,maxHr:l.maxHr,sumCad:l.sumCad,nCad:l.nCad});};
$('btnDiscard').onclick=()=>{store.set('live',null);renderHome();};
$('btnDone').onclick=()=>go('home');
$('btnFit').onclick=()=>{if(!LAST)return;const bytes=buildFIT(LAST);const blob=new Blob([bytes],{type:'application/octet-stream'});
  const a=document.createElement('a');const d=new Date(LAST.start);a.href=URL.createObjectURL(blob);
  a.download='Clayton-ride-'+d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')+'-'+String(d.getHours()).padStart(2,'0')+String(d.getMinutes()).padStart(2,'0')+'.fit';
  document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),5000);toast('Saved to your Downloads folder');};

/* ---------- FIT encoder ---------- */
function buildFIT(ride){
  const FIT_EPOCH=631065600;const out=[];let size=0;const chunks=[];
  const BT={enum:[0x00,1],u8:[0x02,1],u16:[0x84,2],s32:[0x85,4],u32:[0x86,4],u32z:[0x8c,4]};
  const INV={u8:0xff,u16:0xffff,s32:0x7fffffff,u32:0xffffffff,enum:0xff,u32z:0};
  const defs={};
  function def(local,global,fields){defs[local]=fields;const b=[0x40|local,0,0,global&255,global>>8,fields.length];fields.forEach(([n,t])=>b.push(n,BT[t][1],BT[t][0]));push(b);}
  function data(local,vals){const f=defs[local];const b=[local];f.forEach(([n,t],i)=>{let v=vals[i];if(v==null||!isFinite(v))v=INV[t];v=Math.round(v);
      const sz=BT[t][1];if(t==='s32'&&v<0)v=v+0x100000000;for(let k=0;k<sz;k++)b.push(Math.floor(v/2**(8*k))&255);});push(b);}
  function push(b){chunks.push(Uint8Array.from(b));size+=b.length;}
  const ts=u=>u-FIT_EPOCH;const sc=d=>Math.round(d*(2**31/180));
  const s=ride.samples;const t0=s.length?s[0][0]:Math.round(ride.start/1000);const t1=s.length?s[s.length-1][0]:t0+Math.round(ride.elapsed);
  def(0,0,[[0,'enum'],[1,'u16'],[2,'u16'],[3,'u32z'],[4,'u32']]);data(0,[4,255,1,(t0%2147483647)||1,ts(t0)]);
  def(1,21,[[253,'u32'],[0,'enum'],[1,'enum']]);data(1,[ts(t0),0,0]);
  def(2,20,[[253,'u32'],[0,'s32'],[1,'s32'],[2,'u16'],[3,'u8'],[4,'u8'],[5,'u32'],[6,'u16'],[7,'u16']]);
  for(const r of s){data(2,[ts(r[0]),sc(r[1]),sc(r[2]),(r[3]+500)*5,r[4],r[5],r[6]*100,r[7]*1000,r[8]]);}
  data(1,[ts(t1),0,4]);
  const total=s.length?s[s.length-1][6]:ride.dist,el=Math.max(1,t1-t0),timer=ride.elapsed||el;
  def(3,19,[[253,'u32'],[0,'enum'],[1,'enum'],[2,'u32'],[7,'u32'],[8,'u32'],[9,'u32'],[25,'enum'],[39,'enum']]);data(3,[ts(t1),9,1,ts(t0),el*1000,timer*1000,total*100,2,58]);
  def(4,18,[[253,'u32'],[0,'enum'],[1,'enum'],[2,'u32'],[5,'enum'],[6,'enum'],[7,'u32'],[8,'u32'],[9,'u32'],[14,'u16'],[16,'u8'],[17,'u8'],[18,'u8'],[20,'u16'],[21,'u16'],[22,'u16'],[25,'u16'],[26,'u16']]);
  data(4,[ts(t1),8,1,ts(t0),2,58,el*1000,timer*1000,total*100,timer?total/timer*1000:0,ride.avgHr,ride.maxHr,ride.avgCad,ride.avgP,ride.maxP,ride.ascent,0,1]);
  def(5,34,[[253,'u32'],[0,'u32'],[1,'u16'],[2,'enum'],[3,'enum'],[4,'enum'],[5,'u32']]);data(5,[ts(t1),timer*1000,1,0,26,1,ts(t1)-new Date(t1*1000).getTimezoneOffset()*60]);
  const hdr=new Uint8Array(14);const hv=new DataView(hdr.buffer);hv.setUint8(0,14);hv.setUint8(1,0x20);hv.setUint16(2,2132,true);hv.setUint32(4,size,true);hdr.set([46,70,73,84],8);hv.setUint16(12,crc(hdr.subarray(0,12)),true);
  const body=new Uint8Array(size);let o=0;chunks.forEach(c=>{body.set(c,o);o+=c.length;});
  const all=new Uint8Array(14+size+2);all.set(hdr,0);all.set(body,14);const cr=crc(all.subarray(0,14+size));all[14+size]=cr&255;all[15+size]=cr>>8;return all;
}
function crc(bytes){const t=[0x0000,0xCC01,0xD801,0x1400,0xF001,0x3C00,0x2800,0xE401,0xA001,0x6C00,0x7800,0xB401,0x5000,0x9C01,0x8801,0x4400];let c=0;
  for(const b of bytes){let tmp=t[c&0xF];c=(c>>4)&0x0FFF;c=c^tmp^t[b&0xF];tmp=t[c&0xF];c=(c>>4)&0x0FFF;c=c^tmp^t[(b>>4)&0xF];}return c;}

window.addEventListener('resize',()=>{if(R)render();});
go('home');
</script>
