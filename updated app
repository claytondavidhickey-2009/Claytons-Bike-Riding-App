  const tags=[c.loop?'Loop':'Climb',c.region].map((t,i)=>`<span class="tag${!c.loop&&i===0?' climb':''}">${t}</span>`).join('');
  el.innerHTML=`<div style="display:grid;gap:4px;min-width:0"><h3></h3><div class="meta">${dist(c.length,1)} ${distU()} · ↑ ${alt(c.gain).toLocaleString()} ${altU()}${c.loop?'':' · avg '+c.avg.toFixed(1)+'%'}${c.noEle?' · no elevation in file':''}</div><div class="tagrow">${tags}</div></div><div class="btns"></div><canvas></canvas>`;
