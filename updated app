/* ---------- Overture buildings (fills in houses OpenStreetMap is missing) ---------- */
const OVT_BASE='https://overturemaps-extras-us-west-2.s3.us-west-2.amazonaws.com/tiles';
const OVT_FALLBACK='2026-10-21.0';
let pmtilesReady=false;
async function overtureRelease(){
  const cached=store.get('ovtRelease',null);if(cached&&Date.now()-cached.t<3*864e5)return cached.r;
  const ok=r=>/^\d{4}-\d{2}-\d{2}\.\d+$/.test(r);let rel=null;
  try{const u=new URL(OVT_BASE),prefix=u.pathname.replace(/^\/+|\/+$/g,'')+'/';
    const res=await fetch(u.origin+'/?list-type=2&delimiter=%2F&prefix='+encodeURIComponent(prefix));
    if(res.ok){const list=[...(await res.text()).matchAll(/<Prefix>([^<]*)<\/Prefix>/g)].map(m=>m[1].slice(prefix.length).replace(/\/+$/,'')).filter(ok).sort().reverse();rel=list[0]||null;}}catch(e){}
  if(!rel){try{const j=await (await fetch('https://stac.overturemaps.org/catalog.json')).json();if(ok(j.latest))rel=j.latest;}catch(e){}}
  rel=rel||OVT_FALLBACK;store.set('ovtRelease',{r:rel,t:Date.now()});return rel;}
async function addOvertureBuildings(map3){
  if(typeof pmtiles==='undefined')return; // OpenStreetMap buildings stay as they are
  try{if(!pmtilesReady){maplibregl.addProtocol('pmtiles',new pmtiles.Protocol().tile);pmtilesReady=true;}}catch(e){return;}
  const rel=await overtureRelease();if(map3!==m3)return;
  const add=()=>{if(map3!==m3||map3.getSource('ovt'))return;
    map3.addSource('ovt',{type:'vector',url:'pmtiles://'+OVT_BASE+'/'+rel+'/buildings.pmtiles',attribution:'Buildings © Overture Maps Foundation'});
    map3.addLayer({id:'ovt-buildings',type:'fill-extrusion',source:'ovt','source-layer':'building',minzoom:13.5,
      paint:{'fill-extrusion-color':BLDCOL[CAM.style]||BLDCOL.sat,
        'fill-extrusion-height':['case',['has','height'],['to-number',['get','height'],6.5],['has','num_floors'],['*',['to-number',['get','num_floors'],2],3.2],6.5],
        'fill-extrusion-base':['case',['has','min_height'],['to-number',['get','min_height'],0],0],'fill-extrusion-opacity':0.92,'fill-extrusion-vertical-gradient':true}},'peaks');
    // Overture already includes the OpenStreetMap buildings, so hide the OSM copy once Overture tiles arrive
    let swapped=false;const onData=e=>{if(swapped||e.sourceId!=='ovt'||!e.tile)return;swapped=true;
      try{map3.setLayoutProperty('buildings','visibility','none');}catch(_){}map3.off('sourcedata',onData);};
    map3.on('sourcedata',onData);
    map3.on('error',e=>{if(e&&e.sourceId==='ovt'&&!swapped){try{map3.removeLayer('ovt-buildings');map3.removeSource('ovt');}catch(_){}store.set('ovtRelease',null);}});};
  const tryAdd=()=>{try{add();return true;}catch(e){return false;}};
  if(!tryAdd()){const f=()=>{if(tryAdd()){map3.off('styledata',f);map3.off('idle',f);}};map3.on('styledata',f);map3.on('idle',f);}}

